# ==========================================
# CONFIGURACIÓN GENERAL
# ==========================================
FLASK_ENV=production
SECRET_KEY=cambia_esta_clave_por_una_segura
JWT_SECRET_KEY=cambia_esta_clave_jwt_por_una_segura

# ==========================================
# CONEXIÓN A SQL SERVER (BASE DE DATOS EXISTENTE EN OTRO SERVIDOR)
# ==========================================
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=192.168.1.100        # IP o hostname del servidor SQL Server remoto
DB_PORT=1433
DB_NAME=IPH_DB
DB_USER=usuario_sql
DB_PASSWORD=contraseña_sql
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# Cadena armada automáticamente en config.py, pero puedes forzarla aquí si prefieres:
# SQLALCHEMY_DATABASE_URI=mssql+pyodbc://usuario:pass@servidor:1433/IPH_DB?driver=ODBC+Driver+17+for+SQL+Server

# ==========================================
# FRONTEND
# ==========================================
VITE_API_BASE_URL=http://localhost:5000/api

# ==========================================
# GENERACIÓN DE PDF
# ==========================================
PDF_OUTPUT_DIR=/app/app/generated_pdfs
